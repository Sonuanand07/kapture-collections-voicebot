# Port the server listens on (Render/Railway/Heroku set this automatically in production)
PORT=3000

# Optional shared secret — if set, incoming requests must send this in the
# x-webhook-secret header. Configure the same value in Vapi's tool "server" config
# under Headers if you want to lock down who can call your webhook.
WEBHOOK_SECRET=

# Optional: comma-separated list of allowed origins for CORS (leave blank to allow all)
ALLOWED_ORIGINS=
